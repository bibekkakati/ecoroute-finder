# Server Configuration
PORT=3000
NODE_ENV=development

# CORS Configuration (Allowed frontend origin, e.g. http://localhost:5173 or *)
CORS_ORIGIN=*

# Rate Limiting (Max requests per 15-minute window per IP)
RATE_LIMIT_MAX=5000

# SQLite Database (Used for API Key management & session audits via Drizzle ORM)
SQLITE_DB_PATH=./data/eco_route.db

# Redis Configuration (Used for O(log N) prefix autocomplete search)
REDIS_URL=redis://localhost:6379

# Neo4j Graph Database Configuration (Graph routing & road network topology)
GRAPH_DATABASE_PROVIDER=neo4j
GRAPH_DATABASE_URL=bolt://localhost:7687
GRAPH_DATABASE_USERNAME=neo4j
GRAPH_DATABASE_PASSWORD=your_password_here

# Background AQI Sync Worker
ENABLE_AQI_WORKER=true
AQI_WORKER_INTERVAL_MS=5000
